# Configuração do Banco de Dados
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=rifa_db
DB_PORT=3306

# Configuração da Aplicação
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Em produção (Hostinger), altere para:
# NEXT_PUBLIC_BASE_URL=https://rifa.e-br.org

# Segredo que assina o cookie de login (mínimo 32 caracteres).
# Gere um com: openssl rand -hex 32
SESSION_SECRET=troque_por_um_valor_aleatorio_de_64_caracteres
